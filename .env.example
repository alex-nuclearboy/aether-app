# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------

# Generate a new secret key for the local environment with:
#
# uv run python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
#
# Never commit a real production secret key.
# Paste the generated value after the equals sign.
DJANGO_SECRET_KEY=

# Enable Django debug mode for local development only.
# Use False in production.
DJANGO_DEBUG=True

# Comma-separated list of hosts allowed to serve the application.
# Do not include schemes, paths, or trailing slashes.
# Local development examples:
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# ---------------------------------------------------------------------------
# Application locale and time zone
# ---------------------------------------------------------------------------

# Application language.
DJANGO_LANGUAGE_CODE=en-gb

# Application time zone.
DJANGO_TIME_ZONE=UTC
