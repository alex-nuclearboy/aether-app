# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------

# Generate a new secret key for the local environment with:
#
# uv run python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
#
# Never commit a real production secret key.
# Paste the generated value after the equals sign.
DJANGO_SECRET_KEY=

# Enable Django debug mode for local development only.
# Use False in production.
DJANGO_DEBUG=True

# Comma-separated list of hosts allowed to serve the application.
# Do not include schemes, paths, or trailing slashes.
# Local development examples:
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------

# Local PostgreSQL database used by Docker Compose.
POSTGRES_DB=aether
POSTGRES_USER=aether

# Set a password for the local PostgreSQL user.
# Use a URL-safe value, as it is interpolated directly into DATABASE_URL.
POSTGRES_PASSWORD=

# Host and port used by Django to reach PostgreSQL locally.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Database connection
# ---------------------------------------------------------------------------

# PostgreSQL connection URL used by Django.
# Environment references are expanded by the project settings.
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Persistent connection lifetime, in seconds.
# Use 0 to close database connections after each request.
DATABASE_CONN_MAX_AGE=0

# Check persistent connections before reusing them.
DATABASE_CONN_HEALTH_CHECKS=False

# Maximum time, in seconds, allowed to establish a connection.
DATABASE_CONNECT_TIMEOUT=5

# ---------------------------------------------------------------------------
# Application locale and time zone
# ---------------------------------------------------------------------------

# Application language.
DJANGO_LANGUAGE_CODE=en-gb

# Application time zone.
DJANGO_TIME_ZONE=UTC
