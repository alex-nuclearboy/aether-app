# ---------------------------------------------------------------------------
# Local development environment
# ---------------------------------------------------------------------------

# This file is the template for the local Aether development environment.
# Copy it to .env before starting the application.
#
# Production configuration is managed separately by the deployment platform
# and documented in the project documentation.
#
# Do not store production credentials or provider-specific production secrets
# in this file.

# Runtime environment used for environment-specific safety validation.
AETHER_ENVIRONMENT=development

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------

# Generate a new secret key for the local environment with:
#
# uv run python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
#
# Paste the generated value into the local .env file.
# Do not reuse this key in production.
DJANGO_SECRET_KEY=

# Enable Django debug mode for local development.
DJANGO_DEBUG=True

# Comma-separated list of hosts allowed to serve the local application.
# Do not include schemes, paths, or trailing slashes.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# ---------------------------------------------------------------------------
# Django security
# ---------------------------------------------------------------------------

# Additional trusted origins for CSRF validation.
# Normally empty for local development.
DJANGO_CSRF_TRUSTED_ORIGINS=

# The local development server uses HTTP, so HTTPS-only protections remain
# disabled here.
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False

# HTTP Strict Transport Security is not used by the local HTTP development
# server.
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------

# Local PostgreSQL database managed by Docker Compose.
POSTGRES_DB=aether
POSTGRES_USER=aether

# Set a development-only password for the local PostgreSQL user.
# Use a URL-safe value because it is interpolated directly into DATABASE_URL.
POSTGRES_PASSWORD=

# Host and port used by Django to reach the local PostgreSQL instance.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Database connection
# ---------------------------------------------------------------------------

# PostgreSQL connection URL used by Django locally.
# Environment references are expanded by the project settings.
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Persistent connection lifetime, in seconds.
# Zero closes the connection at the end of each request.
DATABASE_CONN_MAX_AGE=0

# Check persistent connections before reusing them.
DATABASE_CONN_HEALTH_CHECKS=False

# Maximum time, in seconds, allowed to establish a database connection.
DATABASE_CONNECT_TIMEOUT=5

# ---------------------------------------------------------------------------
# Application locale and time zone
# ---------------------------------------------------------------------------

DJANGO_LANGUAGE_CODE=en-gb
DJANGO_TIME_ZONE=UTC

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

# Supported levels: DEBUG, INFO, WARNING, ERROR, CRITICAL.

# Fallback level for third-party and otherwise unconfigured loggers.
ROOT_LOG_LEVEL=WARNING

# Aether application logging.
APP_LOG_LEVEL=DEBUG

# Django framework logging.
DJANGO_LOG_LEVEL=INFO

# Database query logging.
# Use DEBUG only temporarily when investigating SQL queries.
DATABASE_LOG_LEVEL=WARNING

# Security and audit events.
AUDIT_LOG_LEVEL=INFO
